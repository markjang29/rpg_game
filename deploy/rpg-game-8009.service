[Unit]
Description=RPG GAME 01 playable prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/rpg-game-01/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/rpg-game-01/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8009 --access-logfile - --error-logfile - web.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
